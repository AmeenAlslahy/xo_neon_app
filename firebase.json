{
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/join",
        "destination": "/join/index.html"
      }
    ],
    "headers": [
      {
        "source": "/join/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "database": {
      "port": 9000
    }
  }
}
